{
  "name": "@AndreeJait/zora-code-rpc",
  "version": "0.2.0",
  "description": "Generated TypeScript gRPC stubs for the Zora Code platform",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreeJait/zora-code-rpc.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./generated/nodejs/index.js",
  "module": "./generated/nodejs/index.js",
  "types": "./generated/nodejs/index.d.ts",
  "files": [
    "generated/",
    "proto/"
  ],
  "scripts": {
    "generate:proto": "node scripts/generate-proto.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.12.0",
    "long": "^5.2.3",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "grpc-tools": "^1.12.4",
    "ts-proto": "^2.6.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
